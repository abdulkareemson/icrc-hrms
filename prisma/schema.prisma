// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  EMPLOYEE
}

enum LeaveStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ComplaintCategory {
  HARASSMENT
  PAYROLL
  WORKPLACE_SAFETY
  LEAVE_DISPUTE
  DISCRIMINATION
  MISCONDUCT
  OTHER
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFER_EXTENDED
  HIRED
  REJECTED
}

enum PerformanceRating {
  OUTSTANDING
  EXCEEDS_EXPECTATIONS
  MEETS_EXPECTATIONS
  BELOW_EXPECTATIONS
  UNSATISFACTORY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  PUBLIC_HOLIDAY
}

enum DocumentType {
  CONTRACT
  OFFER_LETTER
  NIN
  PASSPORT
  CERTIFICATE
  MEDICAL
  DISCIPLINARY
  OTHER
}

enum AnnouncementTarget {
  ALL
  DEPARTMENT
  ROLE
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  VIEW_CONFIDENTIAL
}

// ─────────────────────────────────────────────────────────────
// MODELS — All IDs use uuid() for consistency
// ─────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  role        Role      @default(EMPLOYEE)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  employee      Employee?
  sessions      Session[]
  auditLogs     AuditLog[]        @relation("ActorAuditLogs")
  notifications Notification[]

  hrLeaveApprovals     LeaveRequest[]      @relation("HRLeaveApprovals")
  hrComplaints         Complaint[]         @relation("HRComplaints")
  hrPayrollRuns        PayrollRecord[]     @relation("HRPayrollRuns")
  hrAnnouncements      Announcement[]      @relation("HRAnnouncements")
  hrDocuments          Document[]          @relation("HRDocuments")
  hrVacancies          JobVacancy[]        @relation("HRVacancies")
  hrApplications       JobApplication[]    @relation("HRApplications")
  hrAttendanceEdits    AttendanceLog[]     @relation("HRAttendanceEdits")
  hrPerformanceReviews PerformanceReview[] @relation("HRPerformanceReviews")
  systemConfigUpdates  SystemConfig[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String    @unique
  description String?
  headId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  head          Employee?      @relation("DepartmentHead", fields: [headId], references: [id])
  employees     Employee[]
  announcements Announcement[]
  vacancies     JobVacancy[]
}

model GradeLevel {
  id                 String   @id @default(uuid())
  level              Int
  step               Int
  basicSalary        Int
  housingAllowance   Int
  transportAllowance Int
  medicalAllowance   Int
  leaveAllowance     Int
  utilityAllowance   Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employees      Employee[]
  payrollRecords PayrollRecord[]

  @@unique([level, step])
}

model Employee {
  id               String    @id @default(uuid())
  staffId          String    @unique
  userId           String    @unique
  firstName        String
  middleName       String?
  lastName         String
  gender           String
  dateOfBirth      DateTime
  phoneNumber      String
  personalEmail    String?
  address          String
  stateOfOrigin    String
  lga              String
  nin              String?   @unique
  bankName         String?
  accountNumber    String?
  bankSortCode     String?

  departmentId     String
  gradeLevelId     String
  jobTitle         String
  employmentType   String
  employmentDate   DateTime
  contractEndDate  DateTime?
  confirmationDate DateTime?
  lineManagerId    String?
  isManager        Boolean   @default(false)

  profilePhotoKey  String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department @relation(fields: [departmentId], references: [id])
  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id])
  lineManager      Employee?  @relation("LineManager", fields: [lineManagerId], references: [id])
  directReports    Employee[] @relation("LineManager")

  headedDepartment Department? @relation("DepartmentHead")

  leaveRequests         LeaveRequest[]      @relation("EmployeeLeaveRequests")
  managerLeaveApprovals LeaveRequest[]      @relation("ManagerLeave")
  leaveBalances         LeaveBalance[]
  attendanceLogs        AttendanceLog[]
  complaints            Complaint[]
  payrollRecords        PayrollRecord[]
  reviewsAsReviewee     PerformanceReview[] @relation("Reviewee")
  reviewsAsReviewer     PerformanceReview[] @relation("Reviewer")
  goals                 Goal[]
  documents             Document[]
  jobApplications       JobApplication[]
}

model LeaveType {
  id               String   @id @default(uuid())
  name             String   @unique
  daysAllowed      Int
  isPaid           Boolean  @default(true)
  requiresDocument Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

model LeaveBalance {
  id          String   @id @default(uuid())
  employeeId  String
  leaveTypeId String
  year        Int
  totalDays   Int
  usedDays    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id                String      @id @default(uuid())
  employeeId        String
  leaveTypeId       String
  startDate         DateTime
  endDate           DateTime
  totalDays         Int
  reason            String
  status            LeaveStatus @default(PENDING_MANAGER)
  documentKey       String?

  managerId         String?
  managerComment    String?
  managerApprovedAt DateTime?

  hrAdminId         String?
  hrComment         String?
  hrApprovedAt      DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  employee  Employee  @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  manager   Employee? @relation("ManagerLeave", fields: [managerId], references: [id])
  hrAdmin   User?     @relation("HRLeaveApprovals", fields: [hrAdminId], references: [id])
}

model AttendanceLog {
  id            String           @id @default(uuid())
  employeeId    String
  date          DateTime         @db.Date
  clockInTime   DateTime?
  clockOutTime  DateTime?
  hoursWorked   Float?
  status        AttendanceStatus @default(PRESENT)
  isLate        Boolean          @default(false)
  lateByMinutes Int?
  notes         String?
  editedByHRId  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  editedByHR User?    @relation("HRAttendanceEdits", fields: [editedByHRId], references: [id])

  @@unique([employeeId, date])
}

model Complaint {
  id              String            @id @default(uuid())
  referenceNumber String            @unique
  employeeId      String
  category        ComplaintCategory
  title           String
  description     String
  isConfidential  Boolean           @default(false)
  status          ComplaintStatus   @default(SUBMITTED)

  assignedToId   String?
  assignedAt     DateTime?
  hrNotes        String?
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id])
  assignedTo User?    @relation("HRComplaints", fields: [assignedToId], references: [id])
}

model JobVacancy {
  id               String    @id @default(uuid())
  title            String
  departmentId     String
  jobType          String
  location         String    @default("Abuja, Nigeria")
  description      String
  requirements     String
  responsibilities String
  salaryRange      String?
  deadline         DateTime
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  closedAt         DateTime?
  createdByHRId    String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  department   Department       @relation(fields: [departmentId], references: [id])
  createdByHR  User             @relation("HRVacancies", fields: [createdByHRId], references: [id])
  applications JobApplication[]
}

model JobApplication {
  id             String            @id @default(uuid())
  applicationRef String            @unique
  vacancyId      String

  applicantName  String
  applicantEmail String
  applicantPhone String
  cvKey          String
  coverLetterKey String?
  additionalInfo String?

  status         ApplicationStatus @default(APPLIED)
  interviewDate  DateTime?
  interviewMode  String?
  interviewVenue String?
  hrNotes        String?
  reviewedByHRId String?
  reviewedAt     DateTime?
  employeeId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vacancy      JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  reviewedByHR User?      @relation("HRApplications", fields: [reviewedByHRId], references: [id])
}

model PerformanceReview {
  id              String @id @default(uuid())
  employeeId      String
  reviewerId      String
  reviewPeriod    String
  reviewYear      Int

  employeeSelfRating  PerformanceRating?
  employeeSelfComment String?
  employeeSubmittedAt DateTime?

  managerRating      PerformanceRating?
  managerComment     String?
  managerSubmittedAt DateTime?

  hrFinalRating   PerformanceRating?
  hrComment       String?
  hrFinalizedAt   DateTime?
  hrFinalizedById String?

  isFinalized Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee      Employee @relation("Reviewee", fields: [employeeId], references: [id])
  reviewer      Employee @relation("Reviewer", fields: [reviewerId], references: [id])
  hrFinalizedBy User?    @relation("HRPerformanceReviews", fields: [hrFinalizedById], references: [id])
  goals         Goal[]
}

model Goal {
  id             String     @id @default(uuid())
  reviewId       String
  employeeId     String
  title          String
  description    String
  targetDate     DateTime
  weight         Int
  status         GoalStatus @default(NOT_STARTED)
  completionNote String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id])
}

model PayrollRecord {
  id                 String        @id @default(uuid())
  employeeId         String
  gradeLevelId       String
  payMonth           Int
  payYear            Int

  basicSalary        Int
  housingAllowance   Int
  transportAllowance Int
  medicalAllowance   Int
  leaveAllowance     Int
  utilityAllowance   Int
  otherAllowances    Int           @default(0)
  grossPay           Int

  payeTax            Int
  employeePension    Int
  employerPension    Int
  nhfDeduction       Int
  otherDeductions    Int           @default(0)
  totalDeductions    Int
  netPay             Int

  status            PayrollStatus @default(DRAFT)
  processedByHRId   String?
  processedAt       DateTime?
  paidAt            DateTime?
  payslipKey        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee      Employee   @relation(fields: [employeeId], references: [id])
  gradeLevel    GradeLevel @relation(fields: [gradeLevelId], references: [id])
  processedByHR User?      @relation("HRPayrollRuns", fields: [processedByHRId], references: [id])

  @@unique([employeeId, payMonth, payYear])
}

model Announcement {
  id            String             @id @default(uuid())
  title         String
  content       String
  target        AnnouncementTarget @default(ALL)
  departmentId  String?
  targetRole    Role?
  isUrgent      Boolean            @default(false)
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdByHRId String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  department    Department?    @relation(fields: [departmentId], references: [id])
  createdByHR   User           @relation("HRAnnouncements", fields: [createdByHRId], references: [id])
  notifications Notification[]
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  title          String
  message        String
  link           String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  announcementId String?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
}

model Document {
  id               String       @id @default(uuid())
  employeeId       String
  documentType     DocumentType
  title            String
  fileKey          String
  fileSize         Int
  mimeType         String
  expiresAt        DateTime?
  expiryAlertSent  Boolean      @default(false)
  uploadedByUserId String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  employee       Employee @relation(fields: [employeeId], references: [id])
  uploadedByUser User     @relation("HRDocuments", fields: [uploadedByUserId], references: [id])
}

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String
  actorEmail  String
  action      AuditAction
  entityType  String
  entityId    String
  description String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id])
}

model SystemConfig {
  id               String   @id @default(uuid())
  key              String   @unique
  value            String
  description      String?
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt

  updatedByAdmin User? @relation(fields: [updatedByAdminId], references: [id])
}